# peisear — example configuration.
#
# Copy this file and uncomment only what you want to change:
#
#   cp .env.example .env
#
# **Every line here is commented out, deliberately.** peisear starts
# with no configuration at all, and each value below is already the
# built-in default — so a freshly copied `.env` changes nothing, and
# copying this file can never hand you a setting you did not choose.
#
# That is a rule, not a coincidence. Two defects came from breaking it:
# this file once set `JWT_SECRET` to a placeholder published in the
# public repository, and once set `BIND_ADDR` to every interface after
# the code's own default had moved to loopback. An example file may
# document a default; it must never silently override one.

# ─── Core ─────────────────────────────────────────────────────

# Connection string for the SQLite database. The parent directory is
# auto-created on startup. Use sqlite://:memory: for ephemeral testing.
# DATABASE_URL=sqlite://data/app.db

# HMAC secret for JWT session tokens.
#
# Leave this unset. On first run peisear generates 32 random bytes and
# persists them in a file named `jwt_secret` beside the database, then
# reuses it on later runs. **Back that file up with the database** —
# losing it invalidates every existing session.
#
# Set it explicitly only when you have a reason, such as several
# instances sharing one secret. If you do, generate a real one:
#
#   openssl rand -base64 48
#
# Startup refuses a value that is empty, whitespace-only, or equal to
# a placeholder published in this repository.
# JWT_SECRET=

# Interface and port to bind. Loopback by default, so a first run is
# reachable from this machine only. Use 0.0.0.0:3000 to accept
# connections from other machines — the container image sets that for
# you — and put a TLS reverse proxy in front for anything public.
# BIND_ADDR=127.0.0.1:3000

# Set to 1 when serving over HTTPS so the session cookie is flagged
# Secure. Leave at 0 for plain-HTTP local development.
# COOKIE_SECURE=0

# Any tracing_subscriber env-filter expression. Use debug or trace to
# see per-request detail.
# RUST_LOG=info,sqlx=warn,hyper=warn,tower_http=info

# ─── SMTP (email notifications) ───────────────────────────────
#
# Optional. If SMTP_HOST, SMTP_USER, SMTP_PASSWORD or SMTP_FROM_ADDRESS
# is unset, the email channel degrades quietly and in-app notifications
# keep working.
#
# TLS mode is derived from the port — 465 implicit, 587 STARTTLS,
# anything else implicit — unless SMTP_TLS_MODE says otherwise.

# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_TLS_MODE=implicit
# SMTP_USER=alerts@example.com
# SMTP_PASSWORD=app-specific-password
# SMTP_FROM_ADDRESS=alerts@example.com
# SMTP_FROM_NAME=peisear
